{
  "global": {"resolve_timeout": "5m"},
  "route": {"receiver": "amadeus", "group_by": ["environment", "service", "alertname"], "group_wait": "30s", "group_interval": "5m", "repeat_interval": "1h"},
  "receivers": [{"name": "amadeus", "webhook_configs": [{
    "url": "http://host.docker.internal:8765/webhook/alertmanager",
    "send_resolved": true,
    "max_alerts": 100,
    "http_config": {"authorization": {"type": "Bearer", "credentials_file": "/run/secrets/amadeus_alert_token"}}
  }]}]
}
